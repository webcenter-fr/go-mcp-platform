# syntax=docker/dockerfile:1

# tag: node:22.14.0-bookworm-slim
FROM node:22.14.0-bookworm-slim@sha256:1c18d9ab3af4585870b92e4dbc5cac5a0dc77dd13df1a5905cea89fc720eb05b AS ui
WORKDIR /ui
COPY internal/approval/ui/package.json internal/approval/ui/package-lock.json ./
RUN npm ci
COPY internal/approval/ui/ ./
RUN npm run build

# tag: golang:1.27.4-bookworm
FROM golang:1.27.4-bookworm@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
COPY --from=ui /ui/dist internal/approval/ui/dist
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/approval ./cmd/approval-server

# tag: gcr.io/distroless/static-debian12:nonroot
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=builder /out/approval /usr/local/bin/approval
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/approval"]
